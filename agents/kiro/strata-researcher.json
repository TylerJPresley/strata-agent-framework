          "node ~/.kiro/skills/strata-lifecycle/scripts/research-index.mjs",
          "node ~/.kiro/skills/strata-lifecycle/scripts/research-index.mjs *",
          "timeout * node ~/.kiro/skills/strata-lifecycle/scripts/research-index.mjs",
          "timeout * node ~/.kiro/skills/strata-lifecycle/scripts/research-index.mjs *",
          "npm view",
          "npm view *",
          "git status",
