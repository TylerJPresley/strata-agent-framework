{
  "name": "strata-security-reviewer",
  "description": "Security, trust-boundary, and dependency auditor in fresh context. Use before adopting a new dependency, when reviewing security-sensitive changes, or at release preparation to run audit.mjs and judge flagged vulnerabilities, secrets, and license compliance.",
  "prompt": "You are the Security Reviewer. You audit finished work and dependencies for security vulnerabilities, trust-boundary risks, secrets, and license compliance in fresh context, read-only, judging from deterministic script facts.\n\nIntent: audit dependencies, licenses, secrets, and flagged code patterns before dependency adoption or release.\nReads: `AGENTS.md`, `README.md`, code, dependency manifests, and `_internal/scratch/audit/**`.\nWrites: `_internal/plans/<slug>.security.md` and `_internal/scratch/audit/**`.\n\nMandatory Gates & Workflow:\n1. **Before running an audit:** You MUST call `read_file` on `~/.agents/skills/strata-security-audit/references/security-and-audit.md` and `~/.agents/skills/strata-lifecycle/references/roles-and-standing-rules.md` (Section 3).\n2. **Run Deterministic Audit First:** Execute `timeout 300 node ~/.agents/skills/strata-security-audit/scripts/audit.mjs` and open each flagged `file:line` hit to confirm or rule it out.\n3. **License & Policy Rules:** Check dependency licenses against `Licenses allowed:` in `AGENTS.md` (reject rules bind shipped dependencies; dev-only tooling is `info`). Respect documented policy decisions in `AGENTS.md` or `README.md`.\n4. **Risk Report Contract:** When given a plan slug, write `_internal/plans/<slug>.security.md` with first line `PASS`, `FAIL`, or `ESCALATE` (use `ESCALATE` for any confirmed high/critical finding), followed by findings ranked by severity with `file:line`, source, and date. You may NEVER return `PASS` while any `NEEDS-DECISION` item is open; list open decisions in `CONFLICT` format with options `a*`, `b`, `c`. Reply with the first line and file path only.",
  "tools": [
    "read",
    "grep",
    "glob",
    "shell",
    "write"
  ],
  "resources": [],
  "welcomeMessage": "Security reviewer active. What should I audit?",
  "model": "claude-haiku-4.5",
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "npm ls",
          "npm ls *",
          "npm view",
          "npm view *",
          "npm audit",
          "npm audit *",
          "~/.kiro/skills/strata-security-audit/scripts/audit.mjs",
          "~/.kiro/skills/strata-security-audit/scripts/audit.mjs *",
          "node ~/.kiro/skills/strata-security-audit/scripts/audit.mjs",
          "node ~/.kiro/skills/strata-security-audit/scripts/audit.mjs *",
          "timeout * node ~/.kiro/skills/strata-security-audit/scripts/audit.mjs",
          "timeout * node ~/.kiro/skills/strata-security-audit/scripts/audit.mjs *",
          "node ~/.kiro/skills/strata-security-audit/scripts/audit.mjs --dir *",
          "timeout * node ~/.kiro/skills/strata-security-audit/scripts/audit.mjs --dir *",
          "git status",
          "git status *",
          "git -C * status",
          "git -C * status *",
          "git diff",
          "git diff *",
          "git -C * diff",
          "git -C * diff *",
          "git log",
          "git log *",
          "git -C * log",
          "git -C * log *",
          "git show",
          "git show *",
          "git -C * show",
          "git -C * show *",
          "git rev-parse",
          "git rev-parse *",
          "git -C * rev-parse",
          "git -C * rev-parse *",
          "git rev-list",
          "git rev-list *",
          "git -C * rev-list",
          "git -C * rev-list *",
          "git ls-files",
          "git ls-files *",
          "git -C * ls-files",
          "git -C * ls-files *",
          "git blame",
          "git blame *",
          "git -C * blame",
          "git -C * blame *",
          "git describe",
          "git describe *",
          "git -C * describe",
          "git -C * describe *",
          "git diff-tree",
          "git diff-tree *",
          "git -C * diff-tree",
          "git -C * diff-tree *",
          "git cat-file",
          "git cat-file *",
          "git -C * cat-file",
          "git -C * cat-file *",
          "git merge-base",
          "git merge-base *",
          "git -C * merge-base",
          "git -C * merge-base *",
          "git show-ref",
          "git show-ref *",
          "git -C * show-ref",
          "git -C * show-ref *",
          "git shortlog",
          "git shortlog *",
          "git -C * shortlog",
          "git -C * shortlog *",
          "git branch",
          "git branch -a",
          "git branch -r",
          "git branch -v",
          "git branch -vv",
          "git branch --list",
          "git branch --list *",
          "git branch --show-current",
          "git tag",
          "git tag -l",
          "git tag -l *",
          "git tag --list",
          "git tag --list *",
          "git remote",
          "git remote -v",
          "git config --get *",
          "git stash list",
          "git stash show",
          "git stash show *",
          "cat",
          "cat *",
          "head",
          "head *",
          "tail",
          "tail *",
          "wc",
          "wc *",
          "grep",
          "grep *",
          "sort",
          "sort *",
          "uniq",
          "uniq *",
          "cut",
          "cut *",
          "sha256sum",
          "sha256sum *",
          "sed -n *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "rm _internal/*",
          "rm -* _internal/*",
          "rm _internal/scratch/*",
          "rm -* _internal/scratch/*",
          "rm -* _internal/scratch",
          "rm _internal/backups/*",
          "rm -* _internal/backups/*",
          "rm -* _internal/backups",
          "rm _internal/plans/*.security.md"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git -C * push*",
          "git reset*--hard*",
          "git -C * reset*--hard*",
          "git clean*",
          "git -C * clean*",
          "sudo",
          "sudo *",
          "rm /*",
          "rm * /*",
          "rm ~*",
          "rm * ~*",
          "rm *$*",
          "rm *`*",
          "rm *../*",
          "rm *..",
          "rm *.git",
          "rm *.git/*",
          "rm *.git *",
          "rm .",
          "rm -* .",
          "rm ./",
          "rm -* ./",
          "* .env*",
          "*/.env*",
          "*\".env*",
          "*'.env*",
          "*=.env*",
          "* .ssh*",
          "*/.ssh*",
          "*\".ssh*",
          "*'.ssh*",
          "*=.ssh*",
          "* .aws*",
          "*/.aws*",
          "*\".aws*",
          "*'.aws*",
          "*=.aws*",
          "* .gnupg*",
          "*/.gnupg*",
          "*\".gnupg*",
          "*'.gnupg*",
          "*=.gnupg*",
          "*credentials.json*",
          "*id_rsa*",
          "*id_ed25519*",
          "*id_ecdsa*",
          "*id_dsa*",
          "*.netrc*",
          "*.pem",
          "*.pem *",
          "*.key",
          "*.key *",
          "*.p12",
          "*.p12 *",
          "*.pfx",
          "*.pfx *",
          "*.jks",
          "*.jks *"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git tag*",
          "git -C * tag*"
        ],
        "exclude": [
          "git tag",
          "git tag -l*",
          "git tag --list*",
          "git -C * tag",
          "git -C * tag -l*",
          "git -C * tag --list*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "_internal/plans/*.security.md"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "_internal/scratch/**",
          "_internal/backups/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "_internal/plans/*.security.md",
          "_internal/scratch/**",
          "_internal/backups/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/blueprint.md",
          "**/*-blueprint.md",
          "**/sbp-*.md",
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "**/..*",
          "**/..*/**",
          "**/.netrc",
          "**/*.p12",
          "**/*.pfx",
          "**/*.jks",
          "**/id_rsa*",
          "**/id_ed25519*",
          "**/id_ecdsa*",
          "**/id_dsa*",
          "**/credentials.json",
          "**/.aws/**",
          "**/.ssh/**",
          "**/.gnupg/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "**/..*",
          "**/..*/**",
          "**/.netrc",
          "**/*.p12",
          "**/*.pfx",
          "**/*.jks",
          "**/id_rsa*",
          "**/id_ed25519*",
          "**/id_ecdsa*",
          "**/id_dsa*",
          "**/credentials.json",
          "**/.aws/**",
          "**/.ssh/**",
          "**/.gnupg/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "rm _internal/* *",
          "rm -* _internal/* *"
        ],
        "effect": "ask"
      },
      {
        "capability": "shell",
        "match": [
          "rm _internal",
          "rm _internal/",
          "rm -* _internal",
          "rm -* _internal/"
        ],
        "effect": "deny"
      }
    ]
  }
}
